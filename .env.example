# Discord
TOKEN=           # токен бота из Discord Developer Portal
GUILD_ID=        # ID сервера (правая кнопка на сервере → Копировать ID)
CHANNEL_ID=      # ID канала для объявлений результатов

# PostgreSQL — учётные данные для инициализации контейнера postgres
DB_USER=
DB_PASSWORD=
DB_NAME=

# Строка подключения для бота. Хост — postgres (имя сервиса docker-compose).
# При локальном запуске (npm run dev) замени postgres на localhost.
# Если пароль содержит спецсимволы, закодируй их: @ → %40, # → %23, / → %2F и т.д.
# То же правило действует при сохранении URL в GitHub Secrets.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Тестовый режим: сбрасывать "день" каждые N минут (оставь пустым для прода)
TEST_RESET_EVERY_MINUTES=

# Роли настраиваются в Discord командой !setrole, не через env:
#   !setrole arbuz @Роль      — роль победителя дня
#   !setrole tykvenets @Роль  — роль тыквенца
